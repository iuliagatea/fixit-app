<div class="page-header">
  <h1>
    <%= t.name %> 
  </h1> 
  <br />
  <% if t.categories.any? %>
    <h5><%= render t.categories %></h5>
  <% end %>
</div>
<p><%= t.description %></p>
<% if t.id != current_user.tenants.first %>
  <h4 class="no-black-hover">
    <%= link_to "<i class='bi bi-envelope'></i> Contact".html_safe,
                  tenant_contact_path(t),
                  title: 'Contact' %> 
  </h4> 
<% end %>
<hr />
<% if @user_review.count == 0  %>
  <% if t.id != current_user.tenants.first %>
    <h4 class="no-black-hover">
      <a id="write_review" href="#"><i class="fa fa-pencil"></i> Write review</a>
    </h4>
    <div class="new_review">
      <h3>New Review</h3>
      <%= form_tag({:controller => "reviews", :action => "create"}, {:method => "post", :class => "form-horizontal"}) do %>
        <div class="input-group mb-3">
          <span class="input-group-text col-lg-2">Title</span>
          <%= text_field :title, :class => 'form-control', :placeholder => "Title" %>
        </div> 
        <div class="input-group mb-3">
          <span class="input-group-text col-lg-2">Description</span>
          <%= text_area :review, :class => 'form-control', :placeholder => "Title" %>
        </div> 
        <%= hidden_field(:tenant_id, t.id ) %>
        <%= hidden_field(:user_id, current_user.id ) %>
        <br />
        <div class="input-group mb-3">
          <%= submit_tag "Save".html_safe, class: "btn btn-outline-primary", id:"submit" %>
          <a id="cancel_review" href="#" class = 'btn btn-default'>Cancel review</a>
        </div>
      <% end %>
    </div>
    <br />
  <% end %>
<% end %>

<% if @reviews.count > 0 %>
  <h3>Reviews</h3>
  <%= will_paginate  @reviews %>
    <%= render 'tenants/reviews', obj: @reviews %>
  <%= will_paginate  @reviews %>
<% end %> 
  

