<% if @product.estimates.count > 0 %>
<div class="pdf-card">
  <h2 class="pdf-section-title">Estimate</h2>
  <table class="pdf-table pdf-estimate-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Quantity</th>
        <th>Price</th>
        <th>Value</th>
      </tr>
    </thead>
    <tbody>
      <% @product.estimates.each do |estimate| %>
        <tr>
          <td><%= estimate.name %></td>
          <td><%= estimate.quantity %></td>
          <td><%= estimate.price %></td>
          <td><%= estimate.quantity*estimate.price %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr class="pdf-table-total">
        <td colspan="3">Total</td>
        <td><%= @product.estimated_value %></td>
      </tr>
    </tfoot>
  </table>
</div>
<% end %>
