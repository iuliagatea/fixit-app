<!DOCTYPE html>
<html>
<head>
<title>PDF</title>
  <%# wicked_pdf_stylesheet_link_tag inlines the compiled CSS in-process via
      Sprockets, in every environment. A plain stylesheet_link_tag (what the
      dev branch used to do) emits a host-relative href wkhtmltopdf can never
      resolve when rendering from an HTML string — it has no base URL, so the
      PDF comes back unstyled or fails outright. Always inline it. %>
  <%= wicked_pdf_stylesheet_link_tag 'pdf' %>
</head>
<body>

  <div class='container'>
    <%- model_class = Product -%>

    <table class="pdf-header-table">
      <tr>
        <td class="pdf-brand">FIXIT</td>
        <td class="pdf-header-meta">
          <%=t '.title', :default => model_class.model_name.human.titleize %> Card
          <span class="pdf-doc-code">#<%= @product.code %></span>
        </td>
      </tr>
    </table>

    <%= render 'show' %>
    <%= render 'estimate_show_pdf' %>

    <footer class="pdf-footer">
      <hr class="pdf-footer-rule" />
      <p class="pdf-footer-text">FixIT &copy; <%= Date.today.year %></p>
    </footer>
  </div>

</body>
</html>
