<%= form_for [current_tenant, @product], :html => { :class => "form-horizontal product" } do |f| %>

  <% if @product.errors.any? %>
    <div id="error_expl" class="panel panel-danger">
      <div class="panel-heading">
        <h3 class="panel-title"><%= pluralize(@product.errors.count, "error") %> prohibited this product from being saved:</h3>
      </div>
      <div class="panel-body">
      <ul>
        <% @product.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
    </div>
  <% end %>

  <div class="input-group mb-3">
    <span class="input-group-text col-lg-2">Code</span>
    <%= f.text_field :code, :class => 'form-control', :placeholder => "Code" %>
    <%=f.error_span(:code) %>
  </div>
  <div class="input-group mb-3">
    <span class="input-group-text col-lg-2">Name</span>
    <%= f.text_field :name, :class => 'form-control', :placeholder => "Name" %>
    <%=f.error_span(:name) %>
  </div>
  <div class="input-group mb-3">
    <span class="input-group-text col-lg-2">Expected completion date</span>
    <%= f.text_field :expected_completion_date, :class => 'form-control' %>
    <%=f.error_span(:expected_completion_date) %>
  </div>
  <div class="input-group mb-3">
     <span class="input-group-text col-lg-2">Comments</span>
     <%= f.text_area :comments, :class => 'form-control' %>
    <%=f.error_span(:name) %>
  </div>
  <%= fields_for(:status) do |s| %>
    <div class="input-group mb-3">
       <span class="input-group-text col-lg-2">Status</span>
       <%= s.collection_select :id, @statuses, :id, :name, {}, {class: 'form-control'} %>
    </div>
  <% end %>
  <%= f.hidden_field :tenant_id, value: params[:tenant_id], :class => 'form-control' %>
  <%= fields_for(:user) do |u| %>
    <div class="input-group mb-3">
      <hr />
      <span class="input-group-text col-lg-2">Customer email</span>
      <% if @product.new_record? %>
        <%= u.text_field :email, :class => 'form-control' %>
      <% else %>
        <%= u.text_field :email, :class => 'form-control', :disabled => true %>
        <%= u.hidden_field :email, :class => 'form-control' %>
      <% end %>
    </div>
    <div class="input-group mb-3 customer_name">
      <span class="input-group-text col-lg-2">Customer name</span>
      <div class="form-control" id="customer_name"></div>
    </div>
  <% end %>
  <%= fields_for(:member) do |m| %>
    <div class="member">
    <h5><div class="group-title">Add new customer</div></h5>
    <div class="input-group mb-3">
      <span class="input-group-text col-lg-2">First name</span>
      <%= m.text_field :first_name, :class => 'form-control' %>
      <span class="input-group-text col-lg-2">Last name</span>
      <%= m.text_field :last_name, :class => 'form-control' %>
    </div>
    </div>
  <% end %>
  <div id='estimates'>
  <h5>
    <div class="group-title col-lg-4">Estimates
      <% if !@product.new_record? && @product.estimated_value > 0 %>
          - Total: <%= @product.estimated_value %>
       <% else %><% end %>
    </div>
  </h5>
  <div class="input-group mb-3"></div>

    <%= f.fields_for :estimates do |estimate| %>
      <%= render 'estimate_fields', :f => estimate %>
    <% end %>
  </div>
   
  <div class="input-group mb-3">
      <%= f.submit nil, :class => 'btn btn-primary' %>
      <%= link_to t('.cancel', :default => t("helpers.links.cancel")),
                tenant_products_path, :class => 'btn btn-default' %>
  </div>

<% end %>