<%= form_tag(search_path, class: "d-flex", method: "post", role: "search") do %>
    <%= text_field_tag(:query, "", class:'form-control me-2', type: 'search', placeholder: 'Search service provider..' ) %>
    <% submit_tag "Search".html_safe, class: "btn btn-outline-secondary", id:"submit" %>
    <%= button_tag(type: "submit", class: "btn btn-outline-secondary", id:"submit") do %>
      Search
    <% end %>
<% end %>