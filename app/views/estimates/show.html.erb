<div class="page-header">
  <h1>Product estimate</h1>
  <h3><b><%= @product.name %></b></h3>
</div>

<p id="notice"><%= notice %></p>

<p>
  <strong>Estimate name:</strong>
  <%= @estimate.name %>
</p>

<p>
  <strong>Quantity:</strong>
  <%= @estimate.quantity %>
</p>

<p>
  <strong>Price:</strong>
  <%= @estimate.price %>
</p>

<p>
  <strong>Value:</strong>
  <%= @estimate.value %>
</p>

<p>
  <strong>Tenant:</strong>
  <%= @estimate.tenant %>
</p>

<div>
    <%= link_to 'Back', tenant_product_path, class: 'btn btn-defauly' %>
    <%= link_to 'Edit', edit_tenant_product_estimate_path, class: 'btn btn-default' %>

     <%= link_to t('.destroy', :default => t("helpers.links.destroy")),
                                 tenant_product_estimate_path(Tenant.current_tenant, @product, @estimate),
                                 :method => 'delete',
                                 :data => { :confirm => t('.confirm', :default => t("helpers.links.confirm", :default => 'Are you sure?')) },
                                 :class => 'btn btn-danger' %>
</div>

